# ============================================================
# Server Configuration
# ============================================================
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Health check response value:
# "healthy" -> Matches Master Prompt specification ({"status": "healthy"})
# "ok"      -> Matches BUP Hackathon Section 6.2 spec ({"status": "ok"})
HEALTH_STATUS=healthy

# ============================================================
# LLM Provider Runtime Keys
# NOTE: Injected at runtime or via Render / Railway Dashboard.
# NEVER commit real keys or .env to version control!
# ============================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
